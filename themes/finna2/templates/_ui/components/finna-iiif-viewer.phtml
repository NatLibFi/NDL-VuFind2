<?php
/**
 * Viewer for IIIF manifests and collections.
 *
 * @param string    manifestURL    URL of IIIF manifest to load
 */

use mindplay\vite\Manifest;

$cloverJsxFile = 'components/react-clover/index.tsx';
$manifestPath = $this->scriptSrc('vendor/clover/.vite/manifest.json', true);

$vite = new Manifest(
    manifest_path: $manifestPath,
    base_path: '/vendor/clover/',
    dev: false
);
$reactEntryTags = $vite->createTags($cloverJsxFile);

$cloverEntry = addslashes($vite->getURL($cloverJsxFile));
$manifestQuotesEsc = addslashes($this->manifestURL);
$manifestUrlEnc = urlencode($this->manifestURL);
$loadingText = addslashes($this->transEsc('loading_iiif_viewer'));

/* Pass variables to React component through the window object */
$cloverConfigJS = <<<JS
    const cloverOptions = {};
    window.cloverConfig = {
      iiifManifestURL: "$manifestQuotesEsc",
      loadingText: "$loadingText",
      options: cloverOptions
    };
    JS;

echo $this->assetManager()->outputInlineScriptString($cloverConfigJS);
?>

