<?php
  $hasIcon = !empty($item['icon']['name']);
  $hasImg = !empty($item['image']['url']);
?>
<?php if ($hasImg): ?>
  <div class="feed-img-container">
    <img src="<?=$this->escapeHtmlAttr($item['image']['url']) ?>" alt="" aria-hidden="true">
  </div>
<?php endif; ?>    
<div class="feed-item-container">
  <div class="content-elements">
    <h3 class="title"><?php if ($hasIcon && !$hasImg): ?><?=$this->partial('Helpers/feed-icon.phtml', ['icon' => $item['icon']]);?><?php endif; ?> <?=$this->escapeHtml($item['title'] ?? '') ?></h3>
    <?php if (isset($item['dateFull']) || isset($item['date'])): ?>
      <p class="date"><?= $this->transEsc('Published') ?>: <?= $item['dateFull'] ?? $item['date'] ?></p>
    <?php endif; ?>
    <?php if ((isset($item['description']) || isset($item['text']))): ?>
      <p class="text"><?=$this->escapeHtml($item['description'] ?? $item['text']) ?></p>
    <?php endif; ?>
  </div>
  <?php if (isset($linkText)): ?>
    <p class="link-text"><?= $this->transEsc($this->linkText) ?> <?=$this->icon($linkIcon)?></p>
  <?php endif; ?>
</div>
<!-- END of: finna - ajax/feed-linkbox-item.phtml -->
