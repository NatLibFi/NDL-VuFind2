<!-- START of: finna - ajax/feed-list.phtml -->
<div class="list-feed<?= $this->images ? ' with-image' : ''; ?> <?= $this->display ?>">
<?php if (!$this->translateTitle): // Translated title is displayed in the container, so ignore it here ?>
  <h2 class="feed-header"><?= $this->escapeHtml($this->title) ?></h2>
<?php endif; ?>
<?php if (isset($this->description)): ?><p class="additional-description"><?= $this->translate($this->description) // HTML, intentionally left unescaped ?></p><?php endif; ?>
  <?php
    $featured = $this->display === 'featured';
  ?>
  <div class="feed-list-container <?php if ($featured): ?>feed-featured<?php endif; ?>" role="list">
    <?php
      $featuredItem = '';
      ob_start();
    ?>
    <?php $items = isset($this->visualItems) ? array_slice($this->items, 0, $this->visualItems) : $this->items; ?>
    <?php foreach ($items as $key => $item): ?>
      <?php
        $first = $key === 0;
      ?>
      <div class="feed-list-item" role="listitem">
        <?php if (isset($item['link'])):?>
          <?php
            $linkElement = [
              'href' => $item['link'],
            ];
            if ($this->linkTarget) {
              $linkElement['target'] = $this->linkTarget;
            }
            if ($item['modal']) {
              $linkElement['data-lightbox'] = '';
              $linkElement['data-lightbox-title'] = $item['title'];
            }
          ?>
          <?=$this->partial('ajax/feed-list-item.phtml', compact('item', 'linkElement', 'linkText', 'featured', 'first'))?>
        <?php else: ?>
          <?=$this->partial('ajax/feed-list-item.phtml', compact('item'))?>
        <?php endif; ?>
      </div>
      <?php if ($featured && $first) : ?>
        <?php
          $featuredItem = ob_get_clean();
          ob_start();
        ?>
      <?php endif; ?>
    <?php endforeach; ?>
    <?php $rightSide = ob_get_clean(); ?>
    <?php if ($featured): ?>
      <div class="featured-item">
        <?= $featuredItem ?>
      </div>
    <?php endif; ?>
    <div class="list-container">
      <?= $rightSide ?>
      <?php if ($this->moreLink): ?>
      <div class="more-link" role="listitem">
        <a<?= $this->linkTarget ? ' target="' . $this->escapeHtmlAttr($this->linkTarget) . '"' : '' ?> href="<?= $this->escapeHtmlAttr($this->moreLink); ?>"><?= $this->transEsc('More'); ?>&hellip;</a>
      </div>
    <?php endif; ?>
    </div>
  </div>
</div>
<!-- END of: finna - ajax/feed-list.phtml -->
