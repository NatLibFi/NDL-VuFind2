<!-- START of: finna - RecordTab/holdings-record-urls.phtml -->
<?php
  $openUrl = $this->openUrl($this->driver, 'holdings');
  $openUrlActive = $openUrl->isActive();
  $identifierLinks = $this->identifierLinker($this->driver, 'holdings');
  // Account for replace_other_urls setting
  $urls = $this->record($this->driver)->getLinkDetails($openUrlActive);
?>

<?php
  if (empty($urls) && !$openUrlActive && !$identifierLinks) {
    return;
  }
?>

<div class="record-holdings-url-table">
  <div class="headers">
    <span class="holdings-url-title"><?=$this->transEsc('Links')?></span>
  </div>
  <div class="holdings-urls">
    <?php foreach ($urls ?? [] as $current): ?>
      <?php if (!$this->driver->tryMethod('urlBlocked', [$current['url'], $current['desc']])): ?>
        <div>
          <a class="holdings-url-link icon-link" href="<?=$this->escapeHtmlAttr($this->proxyUrl($current['url']))?>" target="_blank"><?=$this->icon($current['linkType'] ?? 'external-link', 'icon-link__icon')?> <span class="icon-link__label"><?=$this->transEsc('default::link_' . $current['desc'], null, $current['desc'])?> <?=$current['part'] ?? ''?></span><span class="visually-hidden"><?=' ' . $this->transEscAttr('external_online_link')?></span></a>
          <?php if (!empty($current['note'])): ?> <span class="url-public-note"><?=$this->escapeHtml($current['note'])?></span><?php endif; ?>
        </div>
      <?php endif; ?>
    <?php endforeach; ?>
    <?=$identifierLinks?>
    <?php if ($openUrlActive): ?>
      <?=$openUrl->renderTemplate()?>
      <?php
        $loadOpenURLs = "finna.openUrl.initLinks($('.holdings-urls'));";
        echo $this->assetManager()->outputInlineScriptString($loadOpenURLs)
      ?>
    <?php endif; ?>
  </div>
</div>
<!-- END of: finna - RecordTab/holdings-record-urls.phtml -->
