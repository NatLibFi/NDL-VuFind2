<?php
  $linkDetails = $this->record($this->driver)->getLinkDetailsExtended();
  $navigation = [];
  $content = [];
  $active = true;
  foreach ($linkDetails as $name => $links) {
    if (!$links['count'] || !$links['template']) {
      continue;
    }
    $label = $links['template'];
    $navTab = [
      'active' => $active,
      'ariaCurrent' => $active,
      'description' => 'Presentations of ' . $label,
      'label' => $label,
      'link' => '#record-presentation-' . $label,
      '__linkAttributes' => [
        'data-bs-target' => '#record-presentation-' . $label,
        'data-bs-toggle' => 'tab',
      ],
    ];
    $navContent = $this->render("record/mediatabs/$label.phtml", [...$links, 'driver' => $this->driver]);
    $active = false;
    $navigation[] = [
      'tab' => $navTab,
      'content' => $navContent,
    ];
  }

  $tabsAttrs = [];
  if (count($navigation) < 2) {
    $tabsAttrs['class'] = 'hidden';
  }
?>
<div class="record-media-container">
  <?= $this->component(
    'finna-tabs-nav',
      [
        'items' => array_column($navigation, 'tab'),
        'attributes' => $tabsAttrs,
      ]
    ) 
  ?>
  <div class="tab-content">
    <?php foreach ($navigation as $i => $values):?>
      <?php
        $tab = $values['tab'];
      ?>
      <div class="tab-content tab-pane fade show<?=$tab['active'] ? ' active' : ''?>" id="record-presentation-<?= $tab['label'] ?>">
        <?= $values['content'] ?>
      </div>
    <?php endforeach;?>
  </div>
</div>
