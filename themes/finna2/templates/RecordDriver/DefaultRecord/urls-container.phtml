<!-- START of: finna - RecordDriver/DefaultRecord/urls-container.phtml -->
<?php
  $identifierLinks = $this->identifierLinker($this->driver, 'record');
  $openUrl = $this->openUrl($this->driver, 'record');
  $context = $this->context ?? 'record';
  $compact = in_array($context, ['popup', 'results']);
  $header = $this->header ?? '';
  $renderLimit = $this->limit ?? 0;
  $renderedAmount = 0;
  ob_start();
?>
<div class="recordURLs local-available-online-record">
    <div class="fulltextField url-template hidden">
    <a class="fulltext" href="HREF" target="_blank" aria-label="<?=$this->transEscAttr('external_online_link')?>">
      <?=$this->icon('external-link') ?> DESC
      <span class="online-source">SOURCE</span>
    </a>
    <?php if (!empty($url['part'])): ?>
      <span class="coverage"><?=$this->transEsc('default::link_' . $url['part'], null, $url['part']) ?>
    <?php endif; ?>
  </div>
  <div class="truncate-field">
    <?php foreach ($this->onlineURLs['urls'] as $url): ?>
      <?php if ($renderLimit > 0 && $renderedAmount > $renderLimit) {
        break;
      } ?>
      <?= $this->record($this->driver)->renderTemplate('link-fulltext.phtml', [...$url, 'compact' => $compact]) ?>
      <?php $renderedAmount++; ?>
    <?php endforeach; ?>
    <?php foreach ($this->otherURLs['urls'] as $url): ?>
      <?php if ($renderLimit > 0 && $renderedAmount > $renderLimit) {
        break;
      } ?>
      <?= $this->record($this->driver)->renderTemplate('link-fulltext.phtml', [...$url, 'compact' => $compact]) ?>
      <?php $renderedAmount++; ?>
    <?php endforeach; ?>
    <?php if ($this->mergedURLs['count']): ?>
      <div class="merged-urls-wrapper truncate-field" data-button-class="link-buttons" data-row-height="1" data-button-placement="top" data-label="<?=$this->transEscAttr('links_from_other_organisations', ['%%count%%' => $mergedURLs['count']])?>">
        <?php foreach ($this->mergedURLs['urls'] as $url): ?>
          <?php if ($renderLimit > 0 && $renderedAmount > $renderLimit) {
            break;
          } ?>
          <?= $this->record($this->driver)->renderTemplate('link-fulltext.phtml', [...$url, 'compact' => $compact]) ?>
          <?php $renderedAmount++; ?>
        <?php endforeach; ?>
      </div>
    <?php endif; ?>
    <?php if ($context !== 'record'): ?>
      <?php foreach ($this->videoURLs['urls'] as $index => $url): ?>
        <?php if ($renderLimit > 0 && $renderedAmount > $renderLimit) {
          break;
        } ?>
        <?= $this->record($this->driver)->renderTemplate('link-video.phtml', [...$url, 'index' => $index]) ?>
        <?php $renderedAmount++; ?>
      <?php endforeach; ?>
      <?php foreach ($this->audioURLs['urls'] as $index => $url): ?>
        <?php if ($renderLimit > 0 && $renderedAmount > $renderLimit) {
          break;
        } ?>
        <?= $this->record($this->driver)->renderTemplate('link-video.phtml', [...$url, 'index' => $index]) ?>
        <?php $renderedAmount++; ?>
      <?php endforeach; ?>
    <?php endif; ?>
    <?=$identifierLinks?>
    <?php if ($openUrl->isActive()): ?>
      <?=$openUrl->renderTemplate()?><br>
    <?php endif; ?>
  </div>
</div>
<?php $results = ob_get_clean(); ?>
<?php if ($context !== 'popup' && $header && $renderedAmount): ?>
  <strong class="available-online-header"><?=$this->escapeHtml($header)?>:</strong>
<?php endif; ?>
<?= $results ?>

<!-- END of: finna - RecordDriver/DefaultRecord/urls-container.phtml -->
