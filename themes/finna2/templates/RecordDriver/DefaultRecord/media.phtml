<?php
  if ($this->linkDetails['iiifManifests']['count']) {
    return '';
  }
  $mediaAlignment = $this->record($this->driver)->getThumbnailAlignment('result');
?>
<div class="media-<?=$mediaAlignment ?><?=$this->linkDetails['audioURLs']['count'] ? ' audio' : ''?>">
  <?php if ($this->linkDetails['videoURLs']['count'] && $this->config()->inlineVideoEnabled()): ?>
    <?php $i = 0; ?>
      <?php foreach ($this->linkDetails['videoURLs']['urls'] as $url): ?>
        <div class="resource-details">
          <div class="open-link"><a href="<?=$url['url'] ?>" target="_blank" rel="nofollow" download><?=$this->icon('download')?> <?=$this->transEsc('Download video') ?></a></div>
          <?=$this->record($this->driver)->renderTemplate('video-information.phtml', ['i' => $i, 'url' => $url]);?>
        </div>
      <?php $i++; ?>
    <?php endforeach; ?>
  <?php endif; ?>
  <?=$this->record($this->driver)->renderTemplate('record-image-information.phtml');?>
  <?php if ($this->linkDetails['videoURLs']): ?>
    <?=$this->record($this->driver)->renderTemplate('record-video-player.phtml', ['videoUrls' => $this->linkDetails['videoURLs']['urls']]);?>
  <?php endif; ?>

  <?php if ($this->linkDetails['audioURLs']): ?>
    <?=$this->record($this->driver)->renderTemplate('record-audio-player.phtml', ['audioUrls' => $this->linkDetails['audioURLs']['urls']]);?>
  <?php endif; ?>

  <?php if ($this->record($this->driver)->getOrganisationMenuPosition() === 'inline'): ?>
    <div class="organisation-menu">
        <?=$this->render('record/record-organisation-menu.phtml') ?>
    </div>
  <?php endif; ?>

  <?=$this->record($this->driver)->renderTemplate('record-post-thumbnail.phtml');?>
</div>
