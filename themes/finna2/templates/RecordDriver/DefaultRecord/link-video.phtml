<!-- START of: finna - RecordDriver/DefaultRecord/link-video.phtml -->
<?php
  $context = $this->context ?? 'record';
  $popupId = uniqid('finna_' . $this->embed ?? 'video' . '_');
  $buttonAttrs = [
    'class' => $context === 'popup' ? 'videourl fulltext btn btn-primary' : 'btn btn-link',
    'popup-id' => $popupId,
    'source' => $this->proxyUrl($this->url),
    'type' => $this->embed,
    'title' => $this->desc ?? $this->url,
    'consent-service' => 'recordvideo',
    'consent-categories' => $this->cookieConsent()->getCategoryTitleForService('recordvideo'),
    'index' => $this->index,
    'aria-label' => $this->translate('Link to video') . ' ' . $this->desc,
  ];
  if ($context === 'popup') {
    $buttonAttrs['embed-parent'] = 'video-player';
  }
?>
<finna-video
  <?= $this->htmlAttributes($buttonAttrs); ?>
  <?php if (!empty($this->videoSources)): ?>
    video-sources="<?=htmlspecialchars(json_encode($this->videoSources), ENT_QUOTES, 'UTF-8');?>"
  <?php endif; ?>
>
  <?=$this->icon('video-play') ?>
  <span class="video-desc"><?=$this->escapeHtml($this->truncate(ucfirst($this->desc), 30))?></span>
</finna-video>
<!-- END of: finna - RecordDriver/DefaultRecord/link-video.phtml -->
