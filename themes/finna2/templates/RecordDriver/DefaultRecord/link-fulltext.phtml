<!-- START of: finna - RecordDriver/DefaultRecord/link-fulltext.phtml -->
<?php
  $linkId = uniqid('fulltext_link_');
  $linkDescription = trim($this->desc);

  $externalIconMap = [
    'Database Guide' => 'database-info',
    'Database Interface' => 'database-browse',
    'proxy-link' => 'download',
  ];

  // Build the link into a variable to avoid extra whitespaces
  if ($this->linkType === 'proxy-link') {
    $aAttrs = [
      'rel' => 'nofollow',
      'href' => $this->proxyUrl($this->url),
    ];
  } else {
    $aAttrs = [
      'class' => 'fulltext',
      'href' => $this->proxyUrl($this->url),
      'target' => '_blank',
      'aria-label' => $this->translate('external_online_link'),
    ];
  }
  if (in_array($this->linkType, ['download', 'proxy-link'])) {
    $aAttrs['download'] = '';
  }

  // Start the link with wrapping div
  $link = '<div class="fulltextField"><a ' . $this->htmlAttributes($aAttrs) . '>';
  if ($linkIcon = $externalIconMap[$linkDescription] ?? $this->icon ?? 'external-link') {
    $link .= $this->icon($linkIcon) . ' ';
  }

  $link .= $this->transEsc('default::link_' . $linkDescription, null, $linkDescription) . '</a>';
  if ($source = $this->source ?? '') {
    $sourceDesc = is_array($source)
      ? $this->transEsc('Multiple Organisations')
      : $this->transEsc('default::source_' . $source, null, $source);
    $link .= ' (<span class="online-source">' . $sourceDesc . '</span>)';
  }
  if ($linkNote = $this->note ?? '') {
    $link .= ' <span class="url-public-note">' . $this->escapeHtml($linkNote) . '</span>';
  }
  if ($linkPart = $this->part ?? '') {
    $link .= ' <span class="coverage">' . $this->transEsc('default::link_' . $linkPart, null, $linkPart) . '</span>';
  }

  $format = $this->format ?? '';
  $rights = $this->rights ?? [];
  if (!$this->compact && ($format || $rights)) {
    $link .= ' ' . $this->record($this->driver)->renderTemplate('link-rights.phtml', compact('format', 'rights', 'linkId'));
  }
  $link .= '</div>';
?>
<?= $link ?>
<?php if ($rightsDescription = $rights['description'] ?? []): ?>
    <div id="cc_info_<?= $linkId ?>" class="cc-info collapse">
        <?php foreach ($rightsDescription as $item): ?>
            <p class="access-rights"><?=$this->escapeHtml((string)$item);?></p>
        <?php endforeach; ?>
        <button class="hide-info less-link" data-bs-toggle="collapse" data-bs-target="#cc_info_<?= $linkId ?>" aria-expanded="false">
            <?=$this->transEsc('copyright_info_hide')?> <?=$this->icon('truncate-less')?>
        </button>
    </div>
<?php endif; ?>
<!-- END of: finna - RecordDriver/DefaultRecord/link-fulltext.phtml -->
