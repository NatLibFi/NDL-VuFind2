<!-- START of: finna - RecordDriver/DefaultRecord/link-fulltext.phtml -->
<?php
  $linkId = uniqid('fulltext_link_');
  $linkDescription = trim($this->desc);
  $icon = $this->icon ?? 'external-link';
  $isDownloadLink = in_array($this->linkType, ['download', 'proxy-link']);

  $externalIconMap = [
    'Database Guide' => 'database-info',
    'Database Interface' => 'database-browse',
  ];

  // Build the link into a variable to avoid extra whitespaces
  if ($this->linkType === 'proxy-link') {
    $aAttrs = [
      'rel' => 'nofollow',
      'href' => $this->proxyUrl($this->url),
    ];
  } else {
    $aAttrs = [
      'class' => 'fulltext',
      'href' => $this->proxyUrl($this->url),
      'target' => '_blank',
    ];
  }

  // Handle
  if ($isDownloadLink) {
    $aAttrs['download'] = '';
    if (!$linkDescription || $linkDescription === $this->url) {
      $linkDescription = $this->translate('Download the file');
    } else {
      $aAttrs['aria-label'] = $this->translate('Download the file') . ' ' . $linkDescription;
    }
  }

  // Start the link with wrapping div
  $link = '<div class="fulltextField">';

  // Create the actual link element
  $link .= '<a' . $this->htmlAttributes($aAttrs) . '>';

  // Add an icon to the link
  if ($linkIcon = $externalIconMap[$linkDescription] ?? $icon) {
    $link .= $this->icon($linkIcon, 'icon-link__icon') . ' ';
  }

  // Create a label for the link
  $link .= '<span class="icon-link__label">' . $this->transEscWithPrefix('default::link_', $linkDescription) . '</span>';

  // Add visually hidden label for screen readers
  if (!$isDownloadLink) {
    $link .= '<span class="visually-hidden"> ' . $this->transEsc('external_online_link') . '</span>';
  }

  // Close the link element
  $link .= '</a>';

  // Add the additional information after the link:
  if ($source = $this->source ?? '') {
    $sourceDesc = is_array($source)
      ? $this->transEsc('Multiple Organisations')
      : $this->transEscWithPrefix('default::source_', $source);
    $link .= ' (<span class="online-source">' . $sourceDesc . '</span>)';
  }

  if ($linkNote = $this->note ?? '') {
    $link .= ' <span class="url-public-note">' . $this->escapeHtml($linkNote) . '</span>';
  }

  if ($linkPart = $this->part ?? '') {
    $link .= ' <span class="coverage">' . $this->transEscWithPrefix('default::link_', $linkPart) . '</span>';
  }

  $format = $this->format ?? '';
  $rights = $this->rights ?? [];
  if (!$this->compact && ($format || $rights)) {
    $link .= ' ' . $this->record($this->driver)->renderTemplate('link-rights.phtml', compact('format', 'rights', 'linkId'));
  }
  $link .= '</div>';
?>
<?= $link ?>
<?php if ($rightsDescription = $rights['description'] ?? []): ?>
    <div id="cc_info_<?= $linkId ?>" class="cc-info collapse">
        <?php foreach ($rightsDescription as $item): ?>
            <p class="access-rights"><?=$this->escapeHtml((string)$item);?></p>
        <?php endforeach; ?>
        <button class="hide-info less-link" data-bs-toggle="collapse" data-bs-target="#cc_info_<?= $linkId ?>" aria-expanded="false">
            <?=$this->transEsc('copyright_info_hide')?> <?=$this->icon('truncate-less')?>
        </button>
    </div>
<?php endif; ?>
<!-- END of: finna - RecordDriver/DefaultRecord/link-fulltext.phtml -->
