<?php foreach ($data as $url): ?>
  <?php
    $title = $this->escapeHtml($url['title']);
    if (!empty($url['info'])) {
      $title .= ' <span class="info">' . $this->escapeHtml($url['info']) . '</span>';
    }
  ?>
  <?php if (!empty($url['url'])): ?>
    <a class="icon-link" href="<?=$this->escapeHtmlAttr($url['url'])?>" target="_blank" aria-label="<?=$this->escapeHtmlAttr($url['title'])?> (<?=$this->transEscAttr('external_link')?>; <?=$this->transEscAttr('Open in a new window')?>)">
      <?=$this->icon('external-link', 'icon-link__icon') ?>
      <span class="icon-link__label"><?=$title?></span>
    </a>
    <?= $this->escapeHtml($url['subtitle']) ? (' ' . $this->escapeHtml($url['subtitle'])) : '' ?>
  <?php else: ?>
    <?=$title?>
  <?php endif; ?>
  <br>
<?php endforeach; ?>
