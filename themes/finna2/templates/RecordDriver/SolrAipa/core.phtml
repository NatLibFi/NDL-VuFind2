<!-- START of: finna - RecordDriver/SolrAipa/core.phtml -->
<?php
  $recordHelper = $this->record($this->driver);
  $linkDetails = $recordHelper->getLinkDetailsExtended();
  $media = $recordHelper->renderTemplate('media.phtml', $linkDetails);
  $mediaAlignment = $this->record($this->driver)->getThumbnailAlignment('result');
?>

<?php $this->metadata()->generateMetatags($this->driver);?>
<div class="media">
  <h1 class="record-title visible-xs"><?=$this->escapeHtml($this->driver->getTitle())?></h1>
  <?php if ($media && $mediaAlignment == 'left'): ?>
    <?=$media ?>
  <?php endif; ?>
  <div class="media-body record-information">
      <h1 class="record-title hidden-xs"><?=$this->escapeHtml($this->driver->getTitle())?></h1>
      <?php if ($results = $this->driver->getAlternativeTitles()): ?>
        <div class="recordAltTitles record-alt-titles">
          <?=implode('<br>', array_map([$this, 'escapeHtml'], $results))?>
        </div>
      <?php endif; ?>

      <?=$this->record($this->driver)->renderTemplate('cached-record-warning.phtml', ['driver' => $this->driver])?>
      <?=$this->record($this->driver)->getLabelList() ?>

      <?= $recordHelper->renderTemplate('urls-container.phtml', $linkDetails); ?>

      <div class="record-core-metadata">
        <?php $formats = $this->driver->getFormats();
        if (!empty($formats)): ?>
          <span class="recordFormat"><?=$this->record($this->driver)->getFormatList()?></span>
        <?php endif; ?>

        <?php
          $contents = $this->driver->getEncapsulatedContentTypeRecords();
          if (
            ($results = $this->driver->getNonPresenterAuthors())
            || (count($contents) === 1
              && ($results = reset($contents)->getNonPresenterAuthors()))
          ):
        ?>
        <div class="truncate-field recordAuthors">
          <strong><?= $this->transEsc('Aipa::Curated By') ?>:</strong>
          <span>
          <?php foreach ($results as $index => $author): ?>
            <?=($index > 0 ? '; ' : '')?><a href="<?=$this->record($this->driver)->getLink('author', $author['name'])?>"><?=$this->escapeHtml($author['name'])?></a><?php if (!empty($author['date'])): ?><span class="author-date">, <?=$this->escapeHtml($author['date']) ?></span><?php endif; ?>
          <?php endforeach; ?>
          </span>
        </div>
        <?php endif; ?>

        <?php if ($this->driver->getFeedbackEmail()): ?>
          <div>
            <?= $this->transEsc('Aipa::questions_feedback') ?>
            <a href="<?=$this->escapeHtmlAttr($this->recordLinker()->getActionUrl($this->driver, 'Feedback'))?>" data-lightbox><?=$this->transEsc('Send feedback on record')?></a>
          </div>
        <?php endif; ?>

        <?php if ($this->searchOptions($this->driver->getSourceIdentifier())->getVersionsAction()): ?>
          <?=$this->record($this->driver)->renderTemplate('versions-link.phtml')?>
        <?php endif; ?>
      </div>

      <?php /* Display Main Details */?>
      <?=
        $this->record($this->driver)->renderTemplate(
            'core-fields.phtml',
            [
              'driver' => $this->driver,
            ]
        );
      ?>
      <?php /* End Main Details */?>

      <?php if ($abstracts = $this->driver->getAbstracts()): ?>
        <div class="wide summary recordSummary">
          <?= $this->recordFieldMarkdown()->toHTML(implode("\n\n", $abstracts), "\n") ?>
        </div>
      <?php endif; ?>
      <?php
        if (($descriptions = $this->driver->getDescriptions())
          || (count($contents) === 1
            && ($descriptions = reset($contents)->getSummary()))
        ):
      ?>
        <div class="wide summary recordSummary">
          <?= $this->markdown()->toHTML(implode("\n\n", $descriptions)) ?>
        </div>
      <?php endif; ?>

      <?php if ($this->userlist()->getMode() !== 'disabled'): ?>
        <?php /* Display the lists that this record is saved to */ ?>
        <div class="savedLists" id="savedLists">
          <strong><?=$this->transEsc('Saved in')?>:</strong>
        </div>
      <?php endif; ?>

      <?php ob_start(); ?>
      <?= $this->record($this->driver)->renderTemplate('aipa-fields.phtml', [
          'fields' => $this->aipa($this->driver)->getAipaFieldGroup(\Finna\View\Helper\Root\Aipa::AIPA_ADDITIONAL_FIELDS),
        ]) ?>
      <?php $additionalInfo = trim(ob_get_contents()); ?>
      <?php ob_end_clean(); ?>
      <?php if (!empty($additionalInfo)): ?>
        <?= $this->component('finna-panel', [
            'attributes' => ['class' => ['finna-panel-default']],
            'heading' => $this->transEsc('Additional Information'),
            'headingLevel' => 3,
            'content' => $additionalInfo,
            'headingId' => uniqid('heading-'),
            'collapseId' => uniqid('collapse-'),
          ]); ?>
      <?php endif; ?>

      <?php if (count($contents) > 1): ?>
        <div class="record-toc">
          <p><strong><?= $this->transEsc('Contents') ?>:</strong></p>
          <ul>
            <?php foreach ($contents as $id => $record): ?>
              <li>
                <a href="#encapsulated-record-<?= $this->escapeHtmlAttr($id) ?>">
                  <?= $record->getTitle() ?>
                </a>
              </li>
            <?php endforeach; ?>
          </ul>
        </div>
      <?php endif; ?>

      <?= $this->record($this->driver)->renderEncapsulatedRecords(['limit' => null]) ?>

      <?php if ($template = $this->content()->findTemplateForLng('content/Additions/record-post-metadata')): ?>
      <div>
        <?=$this->render($template)?>
      </div>
      <?php endif; ?>
    </div>
  <?php if ($media && $mediaAlignment == 'right'): ?>
    <?=$media ?>
  <?php endif; ?>
</div>
<!-- END of: finna - RecordDriver/SolrAipa/core.phtml -->
