<?php foreach ($this->urls as $current): ?>
  <?php
    $url = $current['url'];
    $target = ' target="_blank"';
    if ('#' === $url[0]) {
      $url = $this->recordLinker()->getUrl($this->driver) . $url;
      $target = '';
    } else {
      $url = $this->proxyUrl($url);
    }
  ?>
  <a href="<?=$this->escapeHtmlAttr($url)?>" class="icon-link fulltext<?=!empty($current['citation']) ? ' citation' : ''?>"<?=$target?>><?=$this->icon('external-link', 'icon-link__icon') ?> <span class="icon-link__label"><?=$this->transEsc($current['desc'])?></span><span class="visually-hidden"><?=' ' . $this->transEscAttr('external_online_link')?></span></a>
<?php endforeach; ?>
<!-- END of: finna - RecordDriver/EDS/online-url-list.phtml -->
