<?php
$fulltextLinkAvailable = false;
foreach ($this->urls as $url) {
  if (!$url['citation']) {
    $fulltextLinkAvailable = true;
    break;
  }
}
$fulltextAvailable = $this->driver->getFulltextAvailable();
$format = $this->driver->getFormats();
$format = end($format);
?>
<?php foreach ($this->urls as $current): ?>
  <a href="<?=$this->escapeHtmlAttr($this->proxyUrl($current['url']))?>" class="icon-link fulltext<?=$current['citation'] ? ' citation' : ''?>" target="_blank" aria-label="<?=$current['citation'] && ($fulltextLinkAvailable || !$fulltextAvailable) ? $this->transEsc('Citation') : $this->transEsc('format_PCI_' . strtolower($format), null, $format) ?> <?=$this->transEsc('external_online_link')?>"><?=$this->icon('external-link', 'icon-link__icon') ?> <span class="icon-link__label"><?=$current['citation'] && ($fulltextLinkAvailable || !$fulltextAvailable) ? $this->transEsc('Citation') : $this->transEsc('format_PCI_' . strtolower($format), null, $format) ?></span></a><?=$current['urlShort'] ? ' <span class="host">' . $current['urlShort'] . '</span>' : '' ?>
<?php endforeach; ?>
<!-- END of: finna - RecordDriver/Primo/online-url-list.phtml -->
