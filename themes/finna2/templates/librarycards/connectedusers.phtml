<h2 class="lightbox-header"><?=$this->transEsc('library_card_connected_users')?></h2>
<table class="table table-striped table-responsive">
  <thead>
    <tr>
      <th scope="col"><?=$this->transEsc('library_card_date_of_connection')?></th>
      <th scope="col"><?=$this->transEsc('Last Login')?></th>
      <th scope="col"><?=$this->transEsc('account_username')?></th>
      <th scope="col"><?=$this->transEsc('account_login_method')?></th>
    </tr>
  </thead>
  <tbody>
    <?php foreach ($this->users as $user): ?>
      <tr>
        <td data-label="<?=$this->transEsc('library_card_date_of_connection')?>"><?=$this->escapeHtml($this->dateTime()->convertToDisplayDateAndTime('U', $user['cardCreated']->getTimeStamp()))?></td>
