<h2 class="lightbox-header"><?=$this->transEsc('library_card_connected_users'); ?></h2>
<table class="table table-striped">
  <tr>
    <th><?=$this->transEsc('library_card_date_of_connection')?></th>
    <th><?=$this->transEsc('Institution')?></th>
    <th><?=$this->transEsc('account_login_method')?></th>
  </tr>
  <?php foreach ($this->users as $user): ?>
    <tr>
      <td><?= $this->escapeHtml($this->dateTime()->convertToDisplayDateAndTime('Y-m-d H:i:s', $user['cardCreated']))?></td>
      <td>
        <?php if ($user['institution']): ?>
          <a href="https://<?=$this->escapeHtmlAttr($user['institution'])?>.finna.fi"><?=$this->transEsc('institution::' . $user['institution'])?></a>
        <?php endif; ?>
      </td>
      <td><?= $this->transEsc('login_method_' . $user['authMethod']) ?></td>
    </tr>
  <?php endforeach; ?>
</table>
<div class="infobox"><?=$this->transEsc('library_card_connected_users_info')?></div>
<button class="btn btn-primary" data-dismiss="modal"><?=ucfirst($this->transEsc('close')) ?></button>
