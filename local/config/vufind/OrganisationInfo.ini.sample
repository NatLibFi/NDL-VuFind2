[Parent_Config]
relative_path = ../finna/OrganisationInfo.ini

[LinkedEvents]
; Uncomment to enable super events in the results.
; Used for Legacy compatibility
;include_super_events = true
; Uncomment to not include publisher id in results by default.
; Used for Legacy compatibility
;include_publisher_id = false

; Default parameters used to fetch results from linked events api
; Default sort used by finna
default_params[sort] = start_time
; Default parameter for including super events. Will override include_super_events
; default_params[super_event_type] = none
; Include sub events from super events with type: umbrella
; default_params[super_event_type] = none,umbrella
default_params[include] = location
