[Site]
; Any local system messages that need to be displayed on the top of every page.
; May contain HTML markup.
;systemMessages[fi] = Lorem ipsum
;systemMessages[en-gb] = Dolores sit amet
; Start and end times for scheduled system messages. Both values are optional.
; Use the format YYYY-MM-DD HH:MM.
;systemMessagesScheduleStart = 2023-01-17 09:00
;systemMessagesScheduleEnd = 2023-01-17 17:00

; Site status. Displayed in a status bar unless value is 'production'.
; Possible values are: 'production', 'beta', 'test' and 'disabled'.
; Default value is 'production'.
status = production
