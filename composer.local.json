{
    "__comment__": [
        "See https://github.com/wikimedia/composer-merge-plugin for more details."
    ],
    "autoload": {
        "psr-4": {
            "Finna\\": ["module/Finna/src/Finna", "module/Finna"],
            "FinnaApi\\": ["module/FinnaApi/src/FinnaApi", "module/FinnaApi"],
            "FinnaConsole\\": ["module/FinnaConsole/src/FinnaConsole", "module/FinnaConsole"],
            "FinnaCustom\\": ["module/FinnaCustom/src/FinnaCustom", "module/FinnaCustom"],
            "FinnaSearch\\": ["module/FinnaSearch/src/FinnaSearch", "module/FinnaSearch"],
            "FinnaTheme\\": ["module/FinnaTheme/src/FinnaTheme", "module/FinnaTheme"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FinnaTest\\": ["module/Finna/src/FinnaTest", "module/Finna/tests/unit-tests/src/FinnaTest"]
        }
    },
    "require": {
        "league/mime-type-detection": "1.9.0",
        "natlibfi/besimple-soap": "3.0.1",
        "natlibfi/finna-code-sets": "0.5.2",
        "natlibfi/finna-xml": "1.0.1",
        "natlibfi/php-html-parser": "4.0.1",
        "phpoffice/phpspreadsheet": "^2.0",
        "picqer/php-barcode-generator": "2.0.1",
        "swen100/geophp": "^1.0.8"
    },
    "scripts": {
        "create-translation-files": "touch local/languages/finna/fi-datasources.ini; touch local/languages/finna/sv-datasources.ini; touch local/languages/finna/en-gb-datasources.ini; touch local/languages/finna/se-datasources.ini;",
        "post-install-cmd": ["@phing-install-dependencies", "@create-translation-files"],
        "post-update-cmd": ["@phing-install-dependencies", "@create-translation-files"],
        "update-npm-deps": [
            "cd themes/finna2 && npm run updateDeps"
        ],
        "install-build-deps": [
            "cd themes/finna2 && npm run installBuildDeps"
        ]
    }
}
